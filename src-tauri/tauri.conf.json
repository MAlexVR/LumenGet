{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LumenGet",
  "version": "0.6.8",
  "identifier": "com.malexvr.lumen",
  "build": {
    "beforeDevCommand": "pnpm --dir ui dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --dir ui build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LumenGet",
        "width": 1100,
        "height": 720,
        "minWidth": 760,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/256x256.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/512x512.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "provides": ["lumen"],
        "conflicts": ["lumen"],
        "replaces": ["lumen"]
      },
      "rpm": {
        "provides": ["lumen"],
        "obsoletes": ["lumen"]
      }
    }
  }
}
